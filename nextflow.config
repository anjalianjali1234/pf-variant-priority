manifest {
    name            = 'pf-variant-priority'
    description     = 'Prioritising variants of unknown significance in P. falciparum resistance panels'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params.tracedir = "${params.outdir}/pipeline_info"

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2
    cpus          = 2
    memory        = 8.GB

    withLabel: gpu   { memory = 16.GB; cpus = 4 }
    withLabel: align { memory = 16.GB }
}

profiles {
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'anjali/pf-variant-priority:0.1.0'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container = 'anjali/pf-variant-priority:0.1.0'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }
    pbspro {
        process.executor = 'pbspro'
        process.queue    = 'workq'
    }
    test {
        params.esm_checkpoint = 'facebook/esm2_t12_35M_UR50D'
        process.cpus = 1
    }
}

timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
